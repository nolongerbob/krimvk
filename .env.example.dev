NODE_ENV=production
PORT=3001

# Staging / dev URL (IP или dev-поддомен)
NEXTAUTH_URL=http://<VPS_IP>:8080
NEXTAUTH_SECRET=replace_with_dev_random_secret

# Отдельная dev-база (рекомендуется)
DATABASE_URL=postgresql://app_user:strong_password@<managed-pg-host>:5432/krimvk_dev?schema=public&sslmode=require

# Хранилище (можно тот же бакет с префиксом dev/ или отдельный бакет)
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=krimvk-uploads-dev
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

HEALTHCHECK_DB=1

RESEND_API_KEY=
EMAIL_FROM=noreply@example.ru

ONE_C_API_BASE_URL=
