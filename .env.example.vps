NODE_ENV=production
PORT=3000

# Обязателен постоянный журнал защиты показаний, общий для всех релизов/процессов.
# На текущем VPS используется этот каталог: сохранить все существующие записи.
METER_SUBMISSION_DIR=/var/www/krimvk/.meter-submissions

# Возможности нового релиза (задаются также при сборке).
NEXT_PUBLIC_ACCOUNT_HOME_ENABLED=true
# Публичный ключ карты: ограничить доменом сайта и Maps JavaScript/Geocoding API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Капелька/осень остаются выключенными, пока администратор не включит их в настройках.
NEXT_PUBLIC_ASSISTANT_ENABLED=true
NEXT_PUBLIC_SEASONAL_ENABLED=true
NEXT_PUBLIC_SITE_NOTICES_ENABLED=true
ASSISTANT_OPERATOR_ENABLED=true
SITE_RUNTIME_SETTINGS_FILE=/home/krimvk/release-shared/site-settings.json
ASSISTANT_BUDGET_DIR=/home/krimvk/release-shared/assistant-budget
# DEEPSEEK_API_KEY хранить только в защищённом серверном окружении.

# 1 — страница «Делаем сервис лучше» (см. docs/MAINTENANCE.md)
MAINTENANCE_MODE=0

# Публичный домен (без слэша в конце). Не IP — иначе письма и выход из аккаунта ведут на сервер.
SITE_URL=https://yourdomain.ru
NEXTAUTH_URL=https://yourdomain.ru
# Редирект с IP на домен (middleware)
CANONICAL_HOST=yourdomain.ru
# Статика Next.js через Yandex CDN (только /_next/static), см. docs/YANDEX_STATIC_CDN.md
# NEXT_PUBLIC_ASSET_PREFIX=https://cdn.yourdomain.ru
NEXTAUTH_SECRET=replace_with_long_random_secret
# AES-256-GCM для userAccount.password1c (openssl rand -base64 32)
PASSWORD1C_ENCRYPTION_KEY=

# Managed PostgreSQL (отдельно от VPS)
DATABASE_URL=postgresql://user:password@<host>:5432/krimvk?schema=public&sslmode=require

# Опционально: Redis для кэша 1С, dashboard overview, rate limits (docker run -p 127.0.0.1:6379:6379 redis:7-alpine)
# REDIS_URL=redis://127.0.0.1:6379

# Yandex Object Storage (рекомендуется для prod)
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=krimvk
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=https://storage.yandexcloud.net/krimvk
S3_USE_ACL=0
S3_PUBLIC_VIA_PROXY=1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ежедневный дамп БД → /var/backups/krimvk + опционально s3://bucket/backups/db/
BACKUP_S3_ENABLED=0
BACKUP_S3_PREFIX=backups/db
S3_RETENTION_DAYS=90

HEALTHCHECK_DB=1

RESEND_API_KEY=
RESEND_FROM_EMAIL=КрымВК <send@yourdomain.ru>

ONE_C_API_BASE_URL=http://46.172.223.34
# Legacy-чтение остаётся без изменений. До включения новых методов заменить
# ONE_C_API_BASE_URL на проверенный HTTPS адрес и закрыть методы ACL/аутентификацией.
ONE_C_UTILITY_ACCESS_ENABLED=false

# DaData (только server-side, /api/address/suggest)
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Оповещения на телефон — см. docs/MOBILE_MONITORING.md
# В РФ удобнее ntfy (приложение ntfy), не Telegram
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Полные алерты: stack trace, перехват console.error в API (см. docs/MOBILE_MONITORING.md)
NTFY_ALERT_ENABLED=1
NTFY_ALERT_STACK=1
NTFY_ALERT_COOLDOWN_MS=120000
# Секрет для POST /api/ops/test-alert (случайная строка)
OPS_TEST_SECRET=
# TELEGRAM_ALERT_BOT_TOKEN=
# TELEGRAM_ALERT_CHAT_ID=

# Ошибки приложения (опционально, облако Sentry + мобильное приложение)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
