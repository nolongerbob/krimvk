# Скопируйте: cp .env.example .env

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_long_password

# DSN только для postgres-exporter (read-only пользователь рекомендуется)
# 127.0.0.1 — postgres-exporter в network_mode: host
POSTGRES_EXPORTER_DSN=postgresql://krimvk_metrics:password@127.0.0.1:5432/krimvk?sslmode=disable&connect_timeout=5
