# Nginx: домен на HTTP (перед certbot) или после certbot замените на nginx.conf.example
# 1) cp в /etc/nginx/sites-available/krimvk
# 2) Замените krimvk.ru на ваш домен
# 3) sudo nginx -t && sudo systemctl reload nginx
# 4) sudo certbot --nginx -d krimvk.ru -d www.krimvk.ru
# 5) После certbot можно перейти на полный nginx.conf.example (HTTPS + rate limits)

upstream krimvk_prod {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name krimvk.ru www.krimvk.ru;

    client_max_body_size 50M;
    proxy_read_timeout 300s;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;

    location /_next/ {
        proxy_pass http://krimvk_prod;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://krimvk_prod;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
