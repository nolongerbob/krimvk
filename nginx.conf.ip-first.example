# Nginx для теста по IP (без домена и SSL)
# Prod: http://<VPS_IP>/
# Dev:  http://<VPS_IP>:8080/  (или отдельный IP — настройте DNS/порт)

upstream krimvk_prod {
    server 127.0.0.1:3000;
    keepalive 64;
}

upstream krimvk_dev {
    server 127.0.0.1:3001;
    keepalive 64;
}

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 50M;
    proxy_read_timeout 300s;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;

    # Метрики для Grafana (только localhost)
    location /nginx_status {
        stub_status on;
        allow 127.0.0.1;
        deny all;
    }

    location / {
        proxy_pass http://krimvk_prod;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

server {
    listen 8080;
    server_name _;

    client_max_body_size 50M;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://krimvk_dev;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
