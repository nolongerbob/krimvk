# Режим обслуживания (подключите внутри server { } для prod).
# Скопируйте: sudo cp nginx/maintenance.conf.example /etc/nginx/snippets/krimvk-maintenance.conf
# В server: include snippets/krimvk-maintenance.conf;
#
# Путь к приложению на VPS:
set $krimvk_app_root /var/www/krimvk;

# Дружелюбная страница, если Node/PM2 не отвечает (502/503/504)
error_page 502 503 504 @krimvk_maintenance;

location @krimvk_maintenance {
    root $krimvk_app_root/public;
    try_files /maintenance.html =503;
    add_header Cache-Control "no-store" always;
    add_header Retry-After "3600" always;
}

location = /maintenance.html {
    root $krimvk_app_root/public;
    add_header Cache-Control "no-store" always;
    add_header Retry-After "3600" always;
}

# Ручной режим (скрипт maintenance-on.sh создаёт /tmp/krimvk-maintenance):
#   if (-f /tmp/krimvk-maintenance) { rewrite ^ /maintenance.html break; }
# Альтернатива: /var/www/krimvk/.maintenance (нужны права на запись в каталог)
# (см. scripts/maintenance-on.sh)
