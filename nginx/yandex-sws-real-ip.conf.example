# Smart Web Security: trusted proxy IPs only.
# real_ip_header / real_ip_recursive must be declared ONCE in http {} (see below).
#
# If /etc/nginx/conf.d/cloudflare-real-ip.conf exists — remove or disable it
# (CF-Connecting-IP is wrong for SWS). Use yandex-sws-real-ip-http.conf.example instead.

set_real_ip_from 51.250.116.133/32;
# Add SWS CIDR ranges from https://yandex.cloud/ru/docs/smartwebsecurity/concepts/connect-domain
