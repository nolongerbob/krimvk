# Подключать в /etc/nginx/conf.d/ ПОСЛЕ включения Smart Web Security (прокси перед VPS).
# IP прокси krimvk.ru — сверьте в консоли SWS → «Как активировать защиту».
# Диапазоны для UFW: https://yandex.cloud/ru/docs/smartwebsecurity/concepts/connect-domain

set_real_ip_from 51.250.116.133/32;
real_ip_header X-Forwarded-For;
real_ip_recursive on;
